# Django
# Leave empty for local dev (a dev-only key is used). Production refuses to start without
# a random 50+ char key: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Browser origins allowed to call the API (production: https://sylhetytutor.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
POSTGRES_DB=sylhetytutor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL / REDIS_URL are only for running Django outside Docker
# (docker-compose.yml sets the container-internal URLs itself).
# Leave DATABASE_URL empty to use SQLite, or point it at the Docker Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sylhetytutor
DATABASE_URL=

# Redis — empty uses in-memory cache; to use the Docker Redis from the host:
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Host ports (change if something else already uses them)
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# JWT
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=10080

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Where NID / student-ID scans are stored (private, never served as /media). Defaults to
# backend/private_media; in production point it at a persistent volume.
# PRIVATE_MEDIA_ROOT=
